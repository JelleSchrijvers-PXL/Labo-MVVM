<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:Todo.UI.ViewModels"
             xmlns:models="clr-namespace:Todo.UI.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Todo.UI.Pages.ToDoListPage"
             x:Name="TodoListPage"
             Title="TodoListPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="LightCoral" />
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
        </Style>
    </ContentPage.Resources>
    
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior 
        EventName="Appearing"
        BindingContext="{Binding Path=BindingContext, Source={x:Reference TodoListPage}, x:DataType=ContentPage}"
        Command="{Binding LoadDataCommand}"/>
    </ContentPage.Behaviors>

    <Grid Padding="20" RowSpacing="5" RowDefinitions="Auto, *">

        <!-- Title -->
        <Label Text="C# Mobile Todo List" 
               FontSize="Title"
               FontAttributes="Bold"
               HorizontalOptions="Center" 
               Margin="0,0,0,20" 
               Grid.Row="0"/>

        <!-- List of To-Dos -->
        <CollectionView ItemsSource="{Binding TodoItems}" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <SwipeView>
                        <SwipeView.LeftItems>
                            <SwipeItems>
                                <SwipeItem 
                                    mi:MauiIcon.Value="{mi:FluentFilled Icon=Delete32Filled, IconSize=Large, IconColor={StaticResource Primary}}" 
                                    BackgroundColor="LightCoral" 
                                    Command="{Binding Source={x:Reference TodoListPage}, Path=BindingContext.DeleteTodoCommand}" 
                                    CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.LeftItems>
                        
                        <Grid ColumnDefinitions="Auto,*">
                            <CheckBox IsChecked="{Binding IsCompleted}" />
                            <Label  Grid.Column="1" 
                                    Text="{Binding Title}"
                                    TextDecorations="{Binding IsCompleted, Converter={StaticResource CompletedTextDecorationConverter}}"
                                    VerticalOptions="Center"
                                    Margin="10,0,0,0" />        
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        <Button Grid.Row="1" HorizontalOptions="End" VerticalOptions="End"
                CornerRadius="45" Padding="25,15" Margin="5" FontSize="24" Text="+" 
                Command="{Binding GoToDetailCommand}" ZIndex="99"/>
    </Grid>
</ContentPage>