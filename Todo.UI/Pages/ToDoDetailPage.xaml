<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.UI.ViewModels"
             x:Class="Todo.UI.Pages.ToDoDetailPage"
             Title="ToDoDetailPage" 
             x:DataType="vm:TodoDetailViewModel">
    <Grid RowDefinitions="*, auto" Padding="10" RowSpacing="5">
        <VerticalStackLayout Spacing="10">
            <Label Text="Titel" FontAttributes="Bold"/>
            <Entry Text="{Binding Title}"/>
            <Label Text="Omschrijving" FontAttributes="Bold"/>
            <Entry Text="{Binding Description}"/>
            <Label Text="Datum" FontAttributes="Bold"/>
            <DatePicker Date="{Binding DueDate}"/>
        </VerticalStackLayout>
        <Button Text="Toevoegen" Grid.Row="1" Command="{Binding SaveCommand}"/>
    </Grid>
</ContentPage>